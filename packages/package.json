{
    "name": "ui-base",
    "version": "0.0.1-9",
    "description": "Vue 2/3 ui-base components",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "sideEffects": [
        "dist/*",
        "styles/**/*.css",
        "styles/src/**/*.styl",
        "esm/components/*/style/*",
        "cjs/components/*/style/*"
    ],
    "exports": {
        ".": {
            "require": "./cjs/index.js",
            "import": "./esm/index.mjs",
            "types": "./esm/index.d.ts"
        },
        "./esm": "./esm/index.mjs",
        "./cjs": "./cjs/index.js",
        "./esm/*.mjs": "./esm/*.mjs",
        "./esm/*": "./esm/*.mjs",
        "./cjs/*.js": "./cjs/*.js",
        "./cjs/*": "./cjs/*.js",
        "./*": "./*"
    },
    "main": "cjs/index.js",
    "module": "esm/index.mjs",
    "types": "esm/index.d.ts",
    "scripts": {},
    "dependencies": {
        "@tinymce/tinymce-vue": "^3.2.8",
        "element-plus": "^2.9.5",
        "element-ui": "^2.15.14",
        "tinymce": "^5.10.7",
        "vue": "^2.7 || ^3.2"
    },
    "_vue3": {
        "@tinymce/tinymce-vue": "^6.1.0",
        "element-plus": "^2.9.5"
    },
    "_vue2": {
        "element-ui": "^2.15.14"
    },
    "publishConfig": {
        "registry": "https://nexus.uzhicai.com/repository/npm-hosted/"
    }
}