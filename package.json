{
  "name": "ui-base",
  "version": "0.2.47",
  "private": false,
  "description": "前端公共组件 公共UI-组件库",
  "license": "ISC",
  "main": "packages/index.js",
  "module": "packages/index.js",
  "typings": "types/index.d.ts",
  "files": [
    "packages/*",
    "types/*"
  ],
  "scripts": {
    "build:vue2": "pnpm --filter ./src/builder run build:vue2",
    "build:vue3": "pnpm --filter ./src/builder run build:vue3",
    "build": "pnpm --filter ./src/builder run build",
    "clean:node_modules": "find . -name \"node_modules\" -type d -exec rm -rf '{}' +",
    "dev:vue2": "pnpm --filter ./src/playground run dev:vue2",
    "dev:vue3": "pnpm --filter ./src/playground run dev:vue3",
    "postinstall": "husky install",
    "lint-staged": "lint-staged",
    "publish": "pnpm --filter ./src/scripts run publish"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint",
    "*.{css,less,scss,styl}": "stylelint"
  },
  "dependencies": {
    "ui-base": "workspace:^",
    "@shared/builder": "workspace:^",
    "@shared/config": "workspace:^",
    "@shared/utils": "workspace:^",
    "@vue3/shared": "npm:@vue/shared@3.2",
    "consola": "^2.15.3",
    "vue2": "npm:vue@2.7",
    "vue3": "npm:vue@3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "8.14.1-alpha.6",
    "cross-env": "^7.0.3",
    "eslint": "9.14.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "stylelint": "^16.7.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-stylus": "^1.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.0.0-alpha.44"
  },
  "engines": {
    "node": ">=18.20.4"
  },
  "publishConfig": {
    "registry": "https://nexus.uzhicai.com/repository/npm-hosted/"
  }
}
